    {
      "split": "train",
      "group": "train-036",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "Training is an explicit offline operation and does not run during chat."
