    {
      "split": "train",
      "group": "train-029",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "Synthetic tests are useful for checking implementation behavior."
