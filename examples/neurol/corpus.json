    {
      "split": "train",
      "group": "train-030",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "A production system needs evaluations beyond a small synthetic corpus."
