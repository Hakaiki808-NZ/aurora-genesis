    {
      "split": "train",
      "group": "train-038",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "A saved candidate can be selected explicitly by its path and digest."
    },
    {
      "split": "train",
      "group": "train-039",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "Learning a short text pattern does not prove instruction following."
