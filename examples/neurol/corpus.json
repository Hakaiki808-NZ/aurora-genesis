    {
      "split": "train",
      "group": "train-035",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "Reviewed examples carry source, license and training permission metadata."
