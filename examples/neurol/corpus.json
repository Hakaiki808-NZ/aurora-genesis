    {
      "split": "train",
      "group": "train-037",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "The model can be disabled while the symbolic Genesis path remains available."
