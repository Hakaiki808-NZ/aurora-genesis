    {
      "split": "train",
      "group": "train-031",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "Weights trained from scratch begin from a seeded random initialization."
    },
    {
      "split": "train",
      "group": "train-032",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "No cloud provider is required for this small CPU training experiment."
