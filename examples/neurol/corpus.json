    {
      "split": "train",
      "group": "train-034",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "The neural subsystem cannot create an Aurora execution receipt."
