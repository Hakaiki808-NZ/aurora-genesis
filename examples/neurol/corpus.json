    {
      "split": "train",
      "group": "train-033",
      "source": "original-synthetic-neurol-v0.1",
      "license": "Apache-2.0",
      "training_allowed": true,
      "reviewed": true,
      "text": "The byte tokenizer represents text as UTF-8 bytes with boundary tokens."
