{
  "openapi": "3.1.0",
  "info": {
    "title": "Kyro private-alpha HTTP API",
    "version": "v0.1-research",
    "description": "Validated route-level reference. Aurora high-consequence operations remain restricted; not a public-beta certification."
  },
  "servers": [
    {
      "url": "https://ces52hcf3e.execute-api.ap-southeast-2.amazonaws.com",
      "description": "Kyro V3 authenticated workspace"
    }
  ],
  "paths": {
    "/api/v3/health": {
      "get": {
        "operationId": "getKyroV3Health",
        "summary": "V3 public health endpoint",
        "security": [],
        "responses": {
          "200": {
            "description": "Health response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "5XX": {
            "description": "Service error"
          }
        }
      }
    },
    "/api/status": {
      "servers": [
        {
          "url": "https://mex7yuj2j2.execute-api.ap-southeast-2.amazonaws.com"
        }
      ],
      "get": {
        "operationId": "getGenesisResearchStatus",
        "summary": "Research model status (JWT required)",
        "security": [
          {
            "kyroBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Research model status JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT"
          }
        }
      }
    },
    "/api/chat": {
      "servers": [
        {
          "url": "https://mex7yuj2j2.execute-api.ap-southeast-2.amazonaws.com"
        }
      ],
      "post": {
        "operationId": "postGenesisResearchChat",
        "summary": "Experimental text chat (JWT required)",
        "description": "Reference-model research interaction. Not a qualified general-purpose neural system.",
        "security": [
          {
            "kyroBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Research chat response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "answer": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid JWT"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "kyroBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Obtain from the official Kyro hosted Cognito OAuth 2.0 authorization-code + PKCE flow. Both APIs use the same Cognito user pool, but each browser client has its own registered audience; never share credentials outside the approved domain."
      }
    }
  },
  "x-kyro-private-routes": [
    {
      "method": "ANY",
      "path": "/api/v3/{proxy+}",
      "security": "Cognito JWT",
      "status": "deployed route; concrete operations are separately versioned"
    },
    {
      "method": "ANY",
      "path": "/api/v3/capabilities/{proxy+}",
      "security": "Cognito JWT",
      "status": "research"
    },
    {
      "method": "ANY",
      "path": "/api/v3/realignment/{proxy+}",
      "security": "Cognito JWT",
      "status": "research"
    },
    {
      "method": "ANY",
      "path": "/api/v3/aurora/{proxy+}",
      "security": "Cognito JWT",
      "status": "C1-only restricted"
    }
  ],
  "x-kyro-identity": {
    "pool": "kyro-dev-private-alpha",
    "issuer": "https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_Pq71kumUV",
    "root_app_client": "7le2ihp8hcee5gptqjis49ovau",
    "workspace_app_client": "68i1h2nqhvsjruneo12k0u3ahm",
    "federation": "not enabled"
  },
  "x-release-gate": "Private alpha; do not interpret this document as public-beta approval"
}
